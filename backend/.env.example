# Application
APP_NAME=IntelVault
DEBUG=false
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1

# PostgreSQL (async driver: asyncpg)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://intelvault:intelvault@localhost:5432/intelvault

# CORS: comma-separated origins for local frontend dev servers
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# JWT (access tokens; use a long random secret, min 32 characters)
JWT_SECRET=change-me-use-openssl-rand-or-python-secrets-token-urlsafe
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
FILE_STORAGE_ROOT=E:/Projects/IntelVault/backend/storage
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
EMBEDDING_DIMENSION=128
ENABLE_OCR=false
OCR_MIN_PAGE_TEXT_CHARS=40
OCR_LANG=eng
TESSERACT_CMD=
LLM_PROVIDER=gemini
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_SECONDS=1.0
GEMINI_REQUEST_TIMEOUT_SECONDS=60.0
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_MAX_RETRIES=3
GROQ_RETRY_BASE_DELAY_SECONDS=1.0
GROQ_REQUEST_TIMEOUT_SECONDS=60.0
PUBLIC_API_BASE_URL=http://127.0.0.1:8000
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.02
RETRIEVAL_LEXICAL_WEIGHT=0.25
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0

# Supabase Storage (optional – leave blank for local filesystem fallback)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents
